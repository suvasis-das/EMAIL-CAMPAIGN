# Server
PORT=4000
# Comma-separated list of allowed frontend origins (e.g. https://your-app.vercel.app,http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# MySQL Database
# Option A: Single connection URL (provided by Railway, Aiven, TiDB, etc.)
# DATABASE_URL=mysql://user:password@host:3306/email_campaigner
# Option B: Individual connection fields
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=email_campaigner
# Set to true for cloud MySQL providers that require TLS/SSL
DB_SSL=false

# Mailtrap SMTP (get these from https://mailtrap.io -> Email Testing -> Inboxes -> SMTP Settings)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM="Email Campaigner <no-reply@campaigner.local>"

# Worker settings
WORKER_BATCH_SIZE=10
WORKER_MAX_RETRIES=3
WORKER_CRON_SCHEDULE=* * * * *
